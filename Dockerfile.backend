# Dev image for the Django/DRF backend.
# Code is mounted as a volume in docker-compose.yml, so local edits show up
# without a rebuild. Rebuild only when requirements.txt changes.

FROM python:3.12-slim

# Prevents .pyc files and forces stdout/stderr to be unbuffered (so logs show up live)
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Copy only requirements first so this layer is cached unless deps change
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the project so the image also runs without the volume mount.
# In docker-compose.yml the mount (.:/app) overrides this in development.
COPY . .

EXPOSE 8000

# Apply migrations, then start the dev server
CMD ["sh", "-c", "python manage.py migrate && python manage.py runserver 0.0.0.0:8000"]